# Set ONLY in the existing TickRouter Railway service.
# Leave DEST_1_* through DEST_4_* completely unchanged.
# Replace the URL placeholder with the real ETH v3q Railway public service URL.
DEST_5_URL="https://YOUR-ETH-V3Q-SERVICE.up.railway.app/webhook"
# MUST exactly equal the ETH brain's WEBHOOK_SECRET.
# Never put the 3Commas code or MANUAL_WEBHOOK_SECRET here.
DEST_5_SECRET="YOUR_ETH_V3Q_BRAIN_WEBHOOK_SECRET"
DEST_5_SYMBOLS="BINANCE:ETHUSDT"
DEST_5_KINDS="fvvo_feature_tick,fvvo_feature_5m"

# Optional: cosmetic router label, if you want startup to display v1g
ROUTER_NAME="TickRouter_AltAssets_v1g_ETH_V3Q_ROUTE"

# ETH v3q BRAIN variables, NOT TickRouter variables:
# C3_AMOUNT_PER_TRADE="30"
# C3_AMOUNT_PER_TRADE_TYPE="quote"
# LOG_FEATURE_TICK_ENABLED="true"
# LOG_15S_TICK_ENABLED="true"
# LOG_15S_TICK_EVERY_N="1"
# LOG_FEATURE_5M_ENABLED="true"
